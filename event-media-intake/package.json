{
  "name": "event-media-intake",
  "version": "0.1.0",
  "description": "Self-hosted event media upload service. Guests stream files directly to the organizer's Google Drive; this service handles session management, duplicate detection, and verification.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrate.js",
    "prune": "node src/lib/retention.js",
    "lint": "eslint src/ client-lib/ tests/",
    "test": "node --test tests/**/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "google-drive",
    "upload",
    "events",
    "resumable",
    "photo",
    "video"
  ],
  "author": "Milton / GenIdem",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.14.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "nodemon": "^3.1.7"
  }
}
