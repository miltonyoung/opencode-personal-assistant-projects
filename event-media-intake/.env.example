# Server
PORT=3000
NODE_ENV=development

# Authentication: coordinator calls must include this key in Authorization: Bearer <key>
UPLOAD_SERVICE_API_KEY=change-me-to-a-long-random-string

# Google OAuth (organizer account)
# Create these via Google Cloud Console + OAuth playground or your own flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Drive
# The Drive API file scope is required.
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/event_media_upload
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=event_media_upload

# Upload limits
MAX_FILE_SIZE_BYTES=5368709120
INIT_UPLOAD_PER_MINUTE=100

# Chunk size (bytes). Default 10 MB. Must be a multiple of 256 KiB.
CHUNK_SIZE_BYTES=10485760

# Retention (days)
RETENTION_COMPLETED_DAYS=180
RETENTION_UPLOADING_DAYS=30
RETENTION_PENDING_DAYS=7
