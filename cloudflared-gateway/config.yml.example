# Copy this file to config.yml and replace the placeholders.
# Then run `cloudflared tunnel route dns <tunnel-id> <hostname>` for each hostname
# or create CNAME records manually in Cloudflare DNS.

tunnel: <your-tunnel-id>
credentials-file: /etc/cloudflared/credentials.json

# NOTE: cloudflared resolves service names on the shared Docker network.
# The names below must match the Compose service names that join `cloudflare-net`.
ingress:
  - hostname: <annie-public-hostname>
    service: http://annie-website:80
    originRequest:
      noTLSVerify: true

  - hostname: <event-media-public-hostname>
    service: http://event-coordinator:3000
    originRequest:
      noTLSVerify: true

  # Any unmatched hostnames return 404.
  - service: http_status:404
